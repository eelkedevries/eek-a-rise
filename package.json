    "e2e": "vite build && node tests/e2e/sequence.e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "mediabunny": "1.61.3"
  }
}
