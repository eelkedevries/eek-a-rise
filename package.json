{
  "name": "eek-a-rise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && vitest run && node scripts/check-claims.mjs && vite build && bash scripts/check-public-build.sh dist && bash scripts/validate-prompts.sh",
